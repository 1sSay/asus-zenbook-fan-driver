[Unit]
Description=ASUS HealthyTable userspace fan driver (UX425QA/UM425QA only)
After=local-fs.target
Conflicts=asus-fan-rpm.service
ConditionArchitecture=x86-64

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/lib/asus-zenbook-fan-driver/service.py
Restart=on-failure
RestartSec=5
RuntimeDirectory=asus-fan-rpm
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022
User=root
CapabilityBoundingSet=CAP_SYS_RAWIO
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/asus-fan-rpm /run/lock
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
KillMode=mixed
TimeoutStopSec=40
TasksMax=32

[Install]
WantedBy=multi-user.target
