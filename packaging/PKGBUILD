pkgname=asus-zenbook-fan-driver
pkgver=0.1.0
pkgrel=1
pkgdesc='Userspace HealthyTable fan driver for ASUS Zenbook UX425QA/UM425QA only'
arch=('x86_64')
url='https://github.com/1sSay/asus-zenbook-fan-driver'
license=('GPL-3.0-or-later' 'MIT' '0BSD')
depends=('glibc' 'python' 'systemd')
makedepends=('gcc' 'make')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz" 'LICENSE')
sha256sums=('34c9d015b4f648cea7cf7e80d9107580dc612b4cb010e1be1f3f215f9055f764' 'cafdac8a4310b4d2c4f910db9acca7ea8eb1c8eb4016b523035ed3ecf460a2a9')

build() {
  make -C "$pkgname-$pkgver"
}

check() {
  make -C "$pkgname-$pkgver" check
}

package() {
  make -C "$pkgname-$pkgver" DESTDIR="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/packaging.LICENSE"
}
